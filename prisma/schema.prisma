generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Protocol {
  x402
  mpp
}

enum Chain {
  base
  solana
}

model ProtocolSnapshot {
  id           String   @id @default(cuid())
  fetchedAt    DateTime @default(now())
  timeframe    Int
  protocol     Protocol
  chain        Chain?
  transactions BigInt
  volume       Decimal  @db.Decimal(20, 6)
  buyers       Int
  sellers      Int

  @@index([fetchedAt])
  @@index([timeframe, protocol, fetchedAt])
}

model ServiceLeaderboardEntry {
  id           String   @id @default(cuid())
  fetchedAt    DateTime
  timeframe    Int
  protocol     Protocol
  rank         Int
  name         String
  href         String?
  logoUrl      String?
  chains       String?
  facilitators String?
  transactions BigInt
  volume       Decimal  @db.Decimal(20, 6)
  buyers       Int

  @@unique([fetchedAt, timeframe, rank])
  @@index([fetchedAt])
  @@index([timeframe, protocol, fetchedAt])
}
