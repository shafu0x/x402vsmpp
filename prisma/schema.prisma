generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Protocol {
  x402
  mpp
}

enum Chain {
  base
  solana
}

model ProtocolSnapshot {
  id           String   @id @default(cuid())
  fetchedAt    DateTime @default(now())
  timeframe    Int
  protocol     Protocol
  chain        Chain?
  transactions BigInt
  volume       Decimal  @db.Decimal(20, 6)
  buyers       Int
  sellers      Int

  @@index([fetchedAt])
  @@index([timeframe, protocol, fetchedAt])
}
